# MkDocs build output
site/

# Auto-populated by hooks/prepare_docs.py before each MkDocs build.
# Never edit anything in here — change the source files at the repo root.
# docs/.gitkeep is the only file tracked so the directory exists at
# checkout time (MkDocs validates docs_dir before any hook runs).
docs/*
!docs/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Editors
.vscode/
.idea/
.DS_Store
